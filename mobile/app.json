{
  "expo": {
    "name": "Maestro Claudio",
    "slug": "maestro-claudio",
    "scheme": "maestroclaudio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lenintoledo.maestroclaudio"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "package": "com.lenintoledo.maestroclaudio"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      ["expo-splash-screen", { "backgroundColor": "#111111", "resizeMode": "contain" }]
    ],
    "extra": {
      "apiUrl": "http://localhost:8001",
      "googleWebClientId": "810546691960-3grg89rm0fv4ammcjldkqe3q687uu1l5.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": ""
    }
  }
}
