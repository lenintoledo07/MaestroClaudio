FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dependencias de sistema:
#   - build-essential, libpq-dev → compilar/conectar Postgres (asyncpg, psycopg)
#   - ffmpeg                     → fallback de Whisper para audio/vídeo
#   - curl                       → healthchecks rápidos en dev
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ffmpeg \
        curl \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt watchfiles

# En dev no hacemos COPY del código: docker-compose.dev.yml monta ./backend:/app
# y sobreescribe el WORKDIR. Esto acelera los rebuilds (sólo cuando cambia
# requirements.txt) y permite hot reload con --reload.

EXPOSE 8001

CMD ["uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "8001"]
